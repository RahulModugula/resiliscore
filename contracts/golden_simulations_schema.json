{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Golden simulations",
  "description": "Scenario key -> sorted applied action ids joined with '+' ('' for none) -> simulate() summary. Generated by backend/scripts/regen_golden.py; net_capex_usd counts only actions not already applied in the scenario; total_annual_savings_usd is base premium minus discounted premium.",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "additionalProperties": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resili_score", "underwriting_tier", "posterior_lcr", "credibility_weight_z",
        "expected_annual_loss_usd", "statutory_discount_pct", "annual_discounted_premium_usd",
        "total_annual_savings_usd", "net_capex_usd", "trigger_code"
      ],
      "properties": {
        "resili_score": { "type": "integer", "minimum": 300, "maximum": 850 },
        "underwriting_tier": { "enum": ["TIER_1_AUTO_BIND", "TIER_2_CONDITIONAL", "TIER_3_DECLINE_ESCALATE"] },
        "posterior_lcr": { "type": "number", "minimum": 0 },
        "credibility_weight_z": { "type": "number", "minimum": 0, "maximum": 1 },
        "expected_annual_loss_usd": { "type": "number", "minimum": 0 },
        "statutory_discount_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "annual_discounted_premium_usd": { "type": "number", "minimum": 0 },
        "total_annual_savings_usd": { "type": "number", "minimum": 0 },
        "net_capex_usd": { "type": "number", "minimum": 0 },
        "trigger_code": {
          "enum": [
            "NONE", "HITL_TRIGGER_01_SENSOR_DIVERGENCE", "HITL_TRIGGER_02_UNPERMITTED_ADDITION",
            "HITL_TRIGGER_03_HIGH_TIV", "HITL_TRIGGER_04_BOUNDARY_CONFLICT"
          ]
        }
      }
    }
  }
}
