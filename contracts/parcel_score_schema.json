{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resiliscore.example/contracts/parcel_score_schema.json",
  "title": "ParcelScoreResponse",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "processing_time_ms": {
      "type": "number"
    },
    "parcel_identity": {
      "$ref": "#/$defs/ParcelIdentity"
    },
    "public_hazard_layer": {
      "$ref": "#/$defs/PublicHazardLayer"
    },
    "private_verification_layer": {
      "$ref": "#/$defs/PrivateVerificationLayer"
    },
    "actuarial_breakdown": {
      "$ref": "#/$defs/ActuarialBreakdown"
    },
    "prescriptive_mitigations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Mitigation"
      }
    },
    "hitl_status": {
      "$ref": "#/$defs/HitlStatus"
    },
    "regulatory_compliance": {
      "$ref": "#/$defs/RegulatoryCompliance"
    },
    "input_provenance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/InputProvenance"
      },
      "default": []
    },
    "factor_contributions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FactorContribution"
      },
      "default": []
    },
    "uncertainty": {
      "anyOf": [
        {
          "$ref": "#/$defs/Uncertainty"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "premium_build": {
      "anyOf": [
        {
          "$ref": "#/$defs/PremiumBuild"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence_log": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceLogEntry"
      },
      "default": []
    },
    "indicative_only": {
      "type": "boolean",
      "default": false
    },
    "nyc": {
      "anyOf": [
        {
          "$ref": "#/$defs/NycLayer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "request_id",
    "processing_time_ms",
    "parcel_identity",
    "public_hazard_layer",
    "private_verification_layer",
    "actuarial_breakdown",
    "prescriptive_mitigations",
    "hitl_status",
    "regulatory_compliance"
